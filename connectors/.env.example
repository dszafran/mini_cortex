# Copy to .env. Existing environment variables win over this file.

# --- hub -----------------------------------------------------------------------
HUB_URL=ws://127.0.0.1:8765/connectors
CONNECTOR_TOKEN=dev-token        # must match the hub's CONNECTOR_TOKEN

# --- Slack (slack_adapter.py) ----------------------------------------------------
SLACK_TOKEN=                     # xoxb-… bot (public channels) or xoxp-… user (your channels + DMs); see slack_manifest.yaml
# SLACK_TOKEN_TYPE=auto          # auto (from the prefix) | bot | user
# SLACK_APP_TOKEN=               # xapp-…  enables Socket Mode (real-time push); otherwise the adapter polls
# SLACK_CHANNELS=general,proj-atlas   # default: every channel the token can read (DMs are not filtered)
# SLACK_JOIN_CHANNELS=1          # bot only: join public channels it is not in yet (needed to read them)
# SLACK_POLL_SECONDS=20
# SLACK_THREAD_LOOKBACK_DAYS=14  # replies are found in threads started up to this long before the window
# SLACK_HISTORY_DAYS=90          # Slack Free's visible history, reported as `coverage`; 0 = unlimited
