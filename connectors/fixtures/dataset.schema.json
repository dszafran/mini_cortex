{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mini-cortex/workshop-dataset/v2",
  "title": "Workshop dataset line",
  "description": "One JSON object per line (JSONL). Theme-agnostic: the generator turns whichever story bible is picked into this format, and the seeders (Mattermost, notes folder, replay) read it. Times are relative: `day` is an offset from workshop day D0 (0 = D0, -3 = three days before) and `time` is local wall-clock time in `meta.timezone`; seeders re-anchor them to a real date at seed time.",
  "oneOf": [
    {"$ref": "#/$defs/meta"},
    {"$ref": "#/$defs/persona"},
    {"$ref": "#/$defs/channel"},
    {"$ref": "#/$defs/chat_post"},
    {"$ref": "#/$defs/chat_dm"},
    {"$ref": "#/$defs/note"},
    {"$ref": "#/$defs/email"},
    {"$ref": "#/$defs/cue"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "username": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,21}$"},
    "day": {"type": "integer", "minimum": -365, "maximum": 30,
            "description": "Offset in days from workshop day D0."},
    "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
             "description": "Local wall-clock time HH:MM in meta.timezone."},
    "concepts": {"type": "array", "items": {"type": "string"},
                 "description": "Story-bible concept labels this item demonstrates (e.g. dedup-merge, supersession). Ignored by seeders; used for traceability and rehearsal."},

    "meta": {
      "type": "object",
      "required": ["kind", "dataset", "timezone", "team", "protagonist", "email_domain"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "meta"},
        "dataset": {"$ref": "#/$defs/slug", "description": "Dataset name, e.g. herdlink."},
        "title": {"type": "string"},
        "timezone": {"type": "string", "description": "IANA zone, e.g. Europe/Vienna."},
        "team": {
          "type": "object", "required": ["name", "display_name"], "additionalProperties": false,
          "properties": {
            "name": {"$ref": "#/$defs/slug", "description": "Chat workspace/team name."},
            "display_name": {"type": "string", "maxLength": 64},
            "description": {"type": "string", "maxLength": 255}
          }
        },
        "protagonist": {"$ref": "#/$defs/id", "description": "Persona id of the person whose memory this is."},
        "email_domain": {"type": "string", "description": "Domain for persona emails, e.g. herdlink.example."}
      }
    },

    "persona": {
      "type": "object",
      "required": ["kind", "id", "name", "username"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "persona"},
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "description": "Display name, 'First Last'."},
        "username": {"$ref": "#/$defs/username"},
        "email": {"type": "string", "description": "Defaults to <username>@<meta.email_domain>."},
        "role": {"type": "string", "description": "Job title or relationship to the protagonist."},
        "in_chat": {"type": "boolean", "default": true,
                          "description": "false for personal-life personas who only appear in notes/email."}
      }
    },

    "channel": {
      "type": "object",
      "required": ["kind", "id", "display_name", "mode"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "channel"},
        "id": {"$ref": "#/$defs/slug", "description": "Chat channel name."},
        "display_name": {"type": "string", "maxLength": 64},
        "purpose": {"type": "string", "maxLength": 250},
        "mode": {"enum": ["history", "live", "dm_archive"],
                 "description": "history: imported backdated, read-only for participants. live: shared writable channel for cues and participant posts. dm_archive: read-only channel holding the protagonist's imported DMs (participant tokens cannot read real DMs)."}
      }
    },

    "chat_post": {
      "type": "object",
      "required": ["kind", "id", "source", "day", "time", "channel", "author", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "item"},
        "id": {"$ref": "#/$defs/id"},
        "source": {"const": "chat"},
        "day": {"$ref": "#/$defs/day"},
        "time": {"$ref": "#/$defs/time"},
        "channel": {"$ref": "#/$defs/slug"},
        "author": {"$ref": "#/$defs/id", "description": "Persona id."},
        "reply_to": {"$ref": "#/$defs/id", "description": "Item id of the thread root (or of any post in the thread)."},
        "content": {"type": "string", "minLength": 1, "maxLength": 16000},
        "concepts": {"$ref": "#/$defs/concepts"}
      }
    },

    "chat_dm": {
      "type": "object",
      "required": ["kind", "id", "source", "day", "time", "author", "participants", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "item"},
        "id": {"$ref": "#/$defs/id"},
        "source": {"const": "chat_dm"},
        "day": {"$ref": "#/$defs/day"},
        "time": {"$ref": "#/$defs/time"},
        "author": {"$ref": "#/$defs/id"},
        "participants": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"},
                         "description": "All persona ids in the conversation, author included."},
        "content": {"type": "string", "minLength": 1, "maxLength": 15000},
        "concepts": {"$ref": "#/$defs/concepts"}
      }
    },

    "note": {
      "type": "object",
      "required": ["kind", "id", "source", "day", "time", "path", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "item"},
        "id": {"$ref": "#/$defs/id"},
        "source": {"const": "note"},
        "day": {"$ref": "#/$defs/day"},
        "time": {"$ref": "#/$defs/time"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _./-]*\\.md$",
                 "description": "Relative path inside the notes folder."},
        "title": {"type": "string"},
        "content": {"type": "string", "minLength": 1},
        "updated": {"type": "object", "required": ["day", "time"], "additionalProperties": false,
                    "properties": {"day": {"$ref": "#/$defs/day"}, "time": {"$ref": "#/$defs/time"}},
                    "description": "Last edit time, if the note was edited after creation."},
        "concepts": {"$ref": "#/$defs/concepts"}
      }
    },

    "email": {
      "type": "object",
      "required": ["kind", "id", "source", "day", "time", "from", "to", "subject", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "item"},
        "id": {"$ref": "#/$defs/id"},
        "source": {"const": "email"},
        "day": {"$ref": "#/$defs/day"},
        "time": {"$ref": "#/$defs/time"},
        "from": {"type": "string", "description": "Persona id, or 'Display Name <address>' for outsiders (newsletters, shops)."},
        "to": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cc": {"type": "array", "items": {"type": "string"}},
        "subject": {"type": "string"},
        "in_reply_to": {"$ref": "#/$defs/id", "description": "Item id of the email this replies to."},
        "content": {"type": "string", "minLength": 1},
        "concepts": {"$ref": "#/$defs/concepts"}
      }
    },

    "cue": {
      "type": "object",
      "required": ["kind", "id", "order", "channel", "author", "content"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "cue"},
        "id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 1},
        "channel": {"$ref": "#/$defs/slug", "description": "Must be a channel with mode live."},
        "author": {"$ref": "#/$defs/id", "description": "Persona the message is attributed to."},
        "content": {"type": "string", "minLength": 1, "maxLength": 16000},
        "post_as": {"enum": ["bot", "persona"], "default": "bot",
                    "description": "bot: posted by the cue bot with an attribution line. persona: posted with the persona's own account."},
        "minute": {"type": "integer", "minimum": 0, "maximum": 180,
                   "description": "Suggested minute in the workshop flow."},
        "demonstrates": {"type": "string"},
        "concepts": {"$ref": "#/$defs/concepts"}
      }
    }
  }
}
