# Copy to .env (never commit .env). The UI (Tune → Models) reads and writes the same file.

# --- model endpoint: Scaleway Generative APIs (default) ---------------------------------------------
# Key: Scaleway console → IAM → API keys. OpenCode's Scaleway provider reads the same two variables.
LLM_PROVIDER=scaleway
SCW_SECRET_KEY=
SCW_PROJECT_ID=                     # empty = default project → https://api.scaleway.ai/v1

# --- or any other OpenAI-compatible endpoint ---------------------------------------------------------
# LLM_PROVIDER=ollama               # http://localhost:11434/v1, no key
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://…/v1
# LLM_API_KEY=

# --- one model per role (Scaleway defaults shown; `uv run doctor` checks each) ------------------------
CHAT_MODEL=glm-5.3                  # chat agent: needs tool calling
EXTRACT_MODEL=deepseek-v4.1-flash   # packetize + dedup: needs structured output
EMBED_MODEL=qwen3-embedding-8b
EMBED_DIM=1024                      # Matryoshka: the server truncates to this size
# EMBED_BASE_URL=                   # only if embeddings come from a different endpoint (same key)

# --- TLS: company proxy or internal endpoint with its own root CA -------------------------------------
# LLM_CA_BUNDLE=~/company-ca.pem    # PEM; trusted on top of the public roots
#   macOS: security find-certificate -c "<root CA name>" -p > ~/company-ca.pem
