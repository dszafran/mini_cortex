# Copy to .env (never commit .env). The UI (Tune → Models) reads and writes the same file.

# --- model endpoint: Scaleway Generative APIs (default) ---------------------------------------------
# Key: Scaleway console → IAM → API keys. OpenCode's Scaleway provider reads the same two variables.
LLM_PROVIDER=scaleway
SCW_SECRET_KEY=
SCW_PROJECT_ID=                     # empty = default project → https://api.scaleway.ai/v1

# --- backup: OpenRouter, when Scaleway runs out of quota (the instructor gives you the key) --------------
# Easiest: Tune → Models → OpenRouter (backup), paste the key, Test connection, Save. By hand: set the two lines
# below and delete CHAT_MODEL, EXTRACT_MODEL and EMBED_MODEL further down (the preset fills OpenRouter's names).
# Same models, so a memory built at Scaleway keeps working.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# --- or any other OpenAI-compatible endpoint ---------------------------------------------------------
# LLM_PROVIDER=ollama               # http://localhost:11434/v1, no key
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://…/v1
# LLM_API_KEY=

# --- one model per role (Scaleway defaults shown; `uv run doctor` checks each) ------------------------
CHAT_MODEL=qwen3-235b-a22b-instruct-2507      # chat agent: needs tool calling
EXTRACT_MODEL=qwen3-235b-a22b-instruct-2507   # packetize + dedup: needs structured output
EMBED_MODEL=qwen3-embedding-8b
EMBED_DIM=1024                      # Matryoshka: the server truncates to this size
# EMBED_BASE_URL=                   # only if embeddings come from a different endpoint (same key)

# --- TLS: company proxy or internal endpoint with its own root CA -------------------------------------
# LLM_CA_BUNDLE=~/company-ca.pem    # PEM; trusted on top of the public roots
#   macOS: security find-certificate -c "<root CA name>" -p > ~/company-ca.pem

# --- the story (the replay connector reads these too) ---------------------------------------------------------
# The story's "today". The prebuilt memory (snapshots/herdlink-full) is built for this day: change both together.
REPLAY_D0=2026-10-23
# When the workshop started, HH:MM in Europe/Vienna (the instructor gives it). The live messages are timed from it,
# so restarting the app keeps their schedule. Empty = timed from each start of the app.
REPLAY_START=

# --- which sources start with the app (none by default: --connector NAME on the command line wins) -----------------
# Workshop step 1: your Slack (also set SLACK_TOKEN, SLACK_APP_TOKEN). No Slack? The offline story: replay
# MINI_CORTEX_CONNECTORS=slack
